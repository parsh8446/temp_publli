{{> head}}
{{> navbar}}

<div class="reading-progress" id="reading-progress" role="progressbar" aria-label="Reading progress" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>

<main class="post">
{{#post}}

   <!-- Full-Width Featured Image -->
   {{#featuredImage}}
   {{#if url}}
   <figure class="post-hero">
      <img src="{{url}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.hero sizes.hero}}{{/if}} {{ lazyload "eager" }} height="{{height}}" width="{{width}}" alt="{{alt}}">
      {{#checkIfAny caption credits}}
      <figcaption>{{caption}} {{credits}}</figcaption>
      {{/checkIfAny}}
   </figure>
   {{/if}}
   {{/featuredImage}}

   <!-- Post Header -->
   <div class="post-header">
      {{#if tags}}
      <div class="post-header__tags">
         {{#each tags}}<a href="{{url}}" class="post-header__tag">{{name}}</a>{{/each}}
      </div>
      {{/if}}
      <h1 class="post-header__title">{{title}}</h1>
      {{#checkIfAny @config.post.displayAuthor @config.post.displayDate}}
      <div class="post-header__meta">
         {{#if @config.post.displayAuthor}}
         {{#author}}
            {{#if avatar}}<img src="{{avatarImage.url}}" {{ lazyload "eager" }} height="{{avatarImage.height}}" width="{{avatarImage.width}}" alt="">{{/if}}
            <a href="{{url}}">{{name}}</a>
         {{/author}}
         {{/if}}
         {{#if @config.post.displayDate}}
         <span class="sep">&bull;</span>
         <time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">{{#checkIf @config.custom.formatDate '!=' 'custom'}}{{date createdAt @config.custom.formatDate}}{{else}}{{date createdAt @config.custom.formatDateCustom}}{{/checkIf}}</time>
         {{/if}}
         {{#if @config.post.displayLastUpdatedDate}}
         {{#if modifiedAt}}
         <span class="sep">&bull;</span>
         <span>{{ translate 'post.lastUpdatedDate' }} {{#checkIf @config.custom.formatDate '!=' 'custom'}}{{date modifiedAt @config.custom.formatDate}}{{else}}{{date modifiedAt @config.custom.formatDateCustom}}{{/checkIf}}</span>
         {{/if}}
         {{/if}}
      </div>
      {{/checkIfAny}}
   </div>

   <!-- Post Body -->
   <div class="post-body">
      {{{text}}}
   </div>

   <!-- AdSense Mid-Content Ad -->
   {{#if @config.custom.adsenseMidContent}}
   <div class="ad-container ad-container--mid-content" aria-label="Advertisement">
      <span class="ad-label">Advertisement</span>
      <div class="ad-slot ad-slot--mid-content">{{{@config.custom.adsenseMidContent}}}</div>
   </div>
   {{/if}}

   <!-- Post Footer: Tags + Share -->
   {{#checkIfAny @config.post.displayTags @config.post.displayShareButtons}}
   <div class="post-footer">
      {{#if @config.post.displayTags}}
      {{#if tags}}
      <div class="post-footer__tags">
         {{#each tags}}<a href="{{url}}" class="post-footer__tag">{{name}}</a>{{/each}}
      </div>
      {{/if}}
      {{/if}}
      {{#if @config.post.displayShareButtons}}
      <div class="content__share">
         <button class="btn--icon content__share-button js-content__share-button">
            <svg width="20" height="20" aria-hidden="true"><use xlink:href="{{@website.assetsUrl}}/svg/svg-map.svg#share"></use></svg>
            <span>{{ translate 'post.shareIt' }}</span>
         </button>
         {{#checkIfAll @plugins.socialSharing @plugins.socialSharing.state}}
            <div class="content__share-popup js-content__share-popup">{{{@customSocialSharing}}}</div>
         {{else}}
            <div class="content__share-popup js-content__share-popup">{{> share-buttons}}</div>
         {{/checkIfAll}}
      </div>
      {{/if}}
   </div>
   {{/checkIfAny}}

   <!-- Author Bio -->
   {{#if @config.post.displayAuthorBio}}
   <div class="post-author-bio">
      {{#author}}
      <div class="post-author-bio__inner">
         {{#if avatar}}<img src="{{avatarImage.url}}" {{ lazyload "lazy" }} height="{{avatarImage.height}}" width="{{avatarImage.width}}" class="post-author-bio__avatar" alt="">{{/if}}
         <div>
            <p class="post-author-bio__name"><a href="{{url}}" rel="author">{{name}}</a></p>
            {{#if description}}<div class="post-author-bio__desc">{{{description}}}</div>{{/if}}
         </div>
      </div>
      {{/author}}
   </div>
   {{/if}}

   <!-- Post Navigation -->
   {{#if @config.post.displayPostNavigation}}
   {{#checkIfAny ../previousPost ../nextPost}}
   <div class="post-nav">
      <div class="post-nav__inner">
         {{#../previousPost}}
         <div class="post-nav__prev">
            <span class="post-nav__label">{{ translate 'post.previousPost' }}</span>
            <a href="{{url}}" class="post-nav__title">{{title}}</a>
         </div>
         {{/../previousPost}}
         {{#../nextPost}}
         <div class="post-nav__next">
            <span class="post-nav__label">{{ translate 'post.nextPost' }}</span>
            <a href="{{url}}" class="post-nav__title">{{title}}</a>
         </div>
         {{/../nextPost}}
      </div>
   </div>
   {{/checkIfAny}}
   {{/if}}

   <!-- Comments -->
   {{#if @config.post.displayComments}}
   <div class="content__comments">
      <div class="post-body">{{{@commentsCustomCode}}}</div>
   </div>
   {{/if}}

   <!-- Related Posts -->
   {{#if @config.post.displayRelatedPosts}}
   {{#if ../relatedPosts}}
   <div class="related-posts">
      <div class="related-posts__inner">
         <h3 class="related-posts__title">You should also read:</h3>
         <div class="related-posts__grid">
            {{#each ../relatedPosts}}
            <a href="{{url}}" class="related-posts__card">
               {{#if @config.custom.feedFeaturedImage}}
               {{#featuredImage}}
               {{#if url}}
               <img src="{{url}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.feed sizes.feed}}{{/if}} {{ lazyload "lazy" }} height="{{height}}" width="{{width}}" alt="{{alt}}" class="related-posts__card-image">
               {{/if}}
               {{/featuredImage}}
               {{/if}}
               <h4 class="related-posts__card-title">{{title}}</h4>
               <div class="related-posts__card-meta">
                  {{#author}}<span>{{name}}</span>{{/author}}
                  {{#if @config.custom.feedDate}}
                  <span>&bull;</span>
                  <time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">{{#checkIf @config.custom.formatDate '!=' 'custom'}}{{date createdAt @config.custom.formatDate}}{{else}}{{date createdAt @config.custom.formatDateCustom}}{{/checkIf}}</time>
                  {{/if}}
               </div>
            </a>
            {{/each}}
         </div>
      </div>
   </div>
   {{/if}}
   {{/if}}

   {{#if @customHTML.afterPost}}
   <div class="banner banner--after-content">
      <div class="wrapper">{{{@customHTML.afterPost}}}</div>
   </div>
   {{/if}}

{{/post}}
</main>

<script>
(function(){
   var bar=document.getElementById('reading-progress');
   if(!bar)return;
   window.addEventListener('scroll',function(){
      var s=window.scrollY||document.documentElement.scrollTop;
      var d=document.documentElement.scrollHeight-window.innerHeight;
      bar.style.width=(d>0?(s/d)*100:0)+'%';
   });
})();
</script>

{{> footer}}
