{{> head}}
{{> navbar}}
<main>

   {{#if @config.custom.adsenseTopBanner}}
   <div class="ad-container ad-container--top" aria-label="Advertisement">
      <div class="wrapper">
         <span class="ad-label">Advertisement</span>
         <div class="ad-slot ad-slot--leaderboard">{{{@config.custom.adsenseTopBanner}}}</div>
      </div>
   </div>
   {{/if}}

   <!-- HERO: First Post Full-Width Overlay -->
   {{#if @renderer.isFirstPage}}
   {{#each posts}}
   {{#if @first}}
   <a href="{{url}}" class="feed__hero" aria-label="{{title}}">
      {{#if @config.custom.feedFeaturedImage}}
         {{#featuredImage}}
            {{#if url}}
               <img class="feed__hero-image" src="{{url}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.hero sizes.hero}}{{/if}} {{ lazyload "eager" }} height="{{height}}" width="{{width}}" alt="{{alt}}">
            {{/if}}
         {{/featuredImage}}
      {{/if}}
      <div class="feed__hero-overlay">
         {{#if tags}}
         <div>
            {{#each tags}}
            <span class="feed__hero-tag">{{name}}</span>
            {{/each}}
         </div>
         {{/if}}
         <h2 class="feed__hero-title"><span>{{title}}</span></h2>
         <div class="feed__hero-meta">
            {{#author}}
               {{#if @config.custom.feedAuthor}}<span>By <span>{{name}}</span></span>{{/if}}
            {{/author}}
            {{#if @config.custom.feedDate}}
               {{#checkIf @config.custom.feedDateType '==' "published"}}
                  <span>&bull;</span>
                  <time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">{{#checkIf @config.custom.formatDate '!=' 'custom'}}{{date createdAt @config.custom.formatDate}}{{else}}{{date createdAt @config.custom.formatDateCustom}}{{/checkIf}}</time>
               {{/checkIf}}
            {{/if}}
         </div>
      </div>
   </a>
   {{/if}}
   {{/each}}
   {{/if}}

   <div class="feed-page">

      <!-- GRID: 2nd and 3rd posts as 2-column overlay cards -->
      {{#if @renderer.isFirstPage}}
      <div class="feed-grid-top">
         {{#each posts}}
         {{#checkIf @index '==' 1}}
         <a href="{{url}}" class="feed__card">
            {{#if @config.custom.feedFeaturedImage}}
               {{#featuredImage}}
                  {{#if url}}
                     <img class="feed__card-image" src="{{url}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.feed sizes.feed}}{{/if}} {{ lazyload "lazy" }} height="{{height}}" width="{{width}}" alt="{{alt}}">
                  {{/if}}
               {{/featuredImage}}
            {{/if}}
            <div class="feed__card-overlay">
               <h3 class="feed__card-title">{{title}}</h3>
               <div class="feed__card-meta">
                  {{#author}}{{#if @config.custom.feedAuthor}}By {{name}}{{/if}}{{/author}}
               </div>
            </div>
         </a>
         {{/checkIf}}
         {{#checkIf @index '==' 2}}
         <a href="{{url}}" class="feed__card">
            {{#if @config.custom.feedFeaturedImage}}
               {{#featuredImage}}
                  {{#if url}}
                     <img class="feed__card-image" src="{{url}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.feed sizes.feed}}{{/if}} {{ lazyload "lazy" }} height="{{height}}" width="{{width}}" alt="{{alt}}">
                  {{/if}}
               {{/featuredImage}}
            {{/if}}
            <div class="feed__card-overlay">
               <h3 class="feed__card-title">{{title}}</h3>
               <div class="feed__card-meta">
                  {{#author}}{{#if @config.custom.feedAuthor}}By {{name}}{{/if}}{{/author}}
               </div>
            </div>
         </a>
         {{/checkIf}}
         {{/each}}
      </div>
      {{/if}}

      {{#if @config.custom.adsenseInFeed}}
      <div class="ad-container ad-container--infeed" aria-label="Advertisement">
         <span class="ad-label">Advertisement</span>
         <div class="ad-slot ad-slot--infeed">{{{@config.custom.adsenseInFeed}}}</div>
      </div>
      {{/if}}

      <!-- LIST: Remaining posts (index 3+) as image-left list -->
      <div class="feed-list">
         {{#each posts}}
         {{#checkIf @index '>=' 3}}
         <article class="feed-list__item">
            {{#if @config.custom.feedFeaturedImage}}
               {{#featuredImage}}
                  {{#if url}}
                     <a href="{{../url}}" class="feed-list__image">
                        <img src="{{url}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.feed sizes.feed}}{{/if}} {{ lazyload "lazy" }} height="{{height}}" width="{{width}}" alt="{{alt}}">
                     </a>
                  {{/if}}
               {{/featuredImage}}
            {{/if}}
            <div class="feed-list__content">
               {{#if tags}}
               {{#each tags}}
               {{#if @first}}<a href="{{url}}" class="feed-list__tag">{{name}}</a>{{/if}}
               {{/each}}
               {{/if}}
               <h2 class="feed-list__title"><a href="{{url}}">{{title}}</a></h2>
               {{#if hasCustomExcerpt}}
                  <p class="feed-list__excerpt">{{{ excerpt }}}</p>
               {{else}}
                  <p class="feed-list__excerpt">{{{ excerpt }}}</p>
               {{/if}}
               <div class="feed-list__meta">
                  {{#author}}
                     {{#if @config.custom.feedAvatar}}{{#if avatar}}<img src="{{avatarImage.url}}" {{ lazyload "lazy" }} height="{{avatarImage.height}}" width="{{avatarImage.width}}" alt="">{{/if}}{{/if}}
                     {{#if @config.custom.feedAuthor}}<a href="{{url}}">{{name}}</a>{{/if}}
                  {{/author}}
                  {{#if @config.custom.feedDate}}
                     {{#checkIf @config.custom.feedDateType '==' "published"}}
                        <span>&bull;</span>
                        <time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">{{#checkIf @config.custom.formatDate '!=' 'custom'}}{{date createdAt @config.custom.formatDate}}{{else}}{{date createdAt @config.custom.formatDateCustom}}{{/checkIf}}</time>
                     {{/checkIf}}
                     {{#checkIf @config.custom.feedDateType '==' "modified"}}
                        <span>&bull;</span>
                        <time datetime="{{date modifiedAt 'YYYY-MM-DDTHH:mm'}}">{{#checkIf @config.custom.formatDate '!=' 'custom'}}{{date modifiedAt @config.custom.formatDate}}{{else}}{{date modifiedAt @config.custom.formatDateCustom}}{{/checkIf}}</time>
                     {{/checkIf}}
                  {{/if}}
               </div>
               {{#if @config.custom.feedtReadMore}}
               <a href="{{url}}" class="feed-list__readmore">{{ translate 'post.readMore' }} &rarr;</a>
               {{/if}}
            </div>
         </article>
         {{/checkIf}}
         {{/each}}
      </div>

      {{> pagination}}
   </div>

   {{#if @config.custom.adsenseBottomBanner}}
   <div class="ad-container ad-container--bottom" aria-label="Advertisement">
      <div class="wrapper">
         <span class="ad-label">Advertisement</span>
         <div class="ad-slot ad-slot--leaderboard">{{{@config.custom.adsenseBottomBanner}}}</div>
      </div>
   </div>
   {{/if}}

</main>
{{> footer}}
